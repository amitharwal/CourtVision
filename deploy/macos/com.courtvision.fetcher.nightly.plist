<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Court Vision fetcher: Every active player's pages at 4:30 AM.
  Replace /PATH/TO/CourtVision below, then install with:
    cp deploy/macos/com.courtvision.fetcher.nightly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.courtvision.fetcher.nightly.plist
  Settings (Cloudflare token and account) come from ~/.config/courtvision/deploy.env; see scripts/run_fetcher.sh.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.courtvision.fetcher.nightly</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/PATH/TO/CourtVision/scripts/run_fetcher.sh</string>
      <string>nightly</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>4</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/courtvision-fetcher-nightly.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/courtvision-fetcher-nightly.log</string>
  </dict>
</plist>
