<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Court Vision fetcher: Today's scoreboard every 10 minutes (deploys only when it changed).
  Replace /PATH/TO/CourtVision below, then install with:
    cp deploy/macos/com.courtvision.fetcher.live.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.courtvision.fetcher.live.plist
  Settings (Cloudflare token and account) come from ~/.config/courtvision/deploy.env; see scripts/run_fetcher.sh.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.courtvision.fetcher.live</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/PATH/TO/CourtVision/scripts/run_fetcher.sh</string>
      <string>live</string>
    </array>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/tmp/courtvision-fetcher-live.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/courtvision-fetcher-live.log</string>
  </dict>
</plist>
